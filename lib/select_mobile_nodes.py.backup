#!/usr/bin/env python3

from pathlib import Path
import json


BASE_DIR = Path(__file__).resolve().parent.parent

INPUT_FILE = (
    BASE_DIR /
    "cache" /
    "filtered" /
    "available.json"
)

OUTPUT_FILE = (
    BASE_DIR /
    "cache" /
    "filtered" /
    "mobile_ru.json"
)


RU_SNI_WORDS = [
    "yandex",
    "ya.ru",
    "vk.com",
    "userapi.com",
    "x5.ru",
    "max.ru",
    "ozon",
    "ozone",
]


def get_sni(proxy):
    return (
        proxy.get("servername")
        or proxy.get("sni")
        or ""
    ).lower()


def classify(proxy):

    name = proxy.get("name", "").lower()
    sni = get_sni(proxy)

    text = name + " " + sni

    is_ru = any(
        x in text
        for x in [
            "ru",
            "russia",
            "🇷🇺",
            "cidr",
            "mobile",
        ]
    )

    is_sni_ru = any(
        x in sni
        for x in RU_SNI_WORDS
    )

    network = proxy.get("network")
    port = proxy.get("port")
    ptype = proxy.get("type")

    if ptype == "hysteria2":
        return "HY2_BACKUP"

    if not (is_ru or is_sni_ru):
        return None

    if network == "tcp" and port == 443:
        return "RU_TCP_443"

    if network == "grpc":
        return "RU_GRPC"

    if network == "xhttp":
        return "RU_XHTTP"

    return "OTHER_RU"


def main():

    with INPUT_FILE.open(
        encoding="utf-8"
    ) as f:
        proxies = json.load(f)


    result = {
        "RU_TCP_443": [],
        "RU_GRPC": [],
        "RU_XHTTP": [],
        "HY2_BACKUP": [],
        "OTHER_RU": [],
    }


    for proxy in proxies:

        group = classify(proxy)

        if group:
            result[group].append(proxy)


    OUTPUT_FILE.parent.mkdir(
        parents=True,
        exist_ok=True
    )


    with OUTPUT_FILE.open(
        "w",
        encoding="utf-8"
    ) as f:
        json.dump(
            result,
            f,
            ensure_ascii=False,
            indent=2
        )


    print("MOBILE RU SELECTION")
    print("===================")

    total = 0

    for k,v in result.items():
        print(
            f"{k}: {len(v)}"
        )
        total += len(v)

    print("-------------------")
    print(
        "TOTAL:",
        total
    )

    print(
        "FILE:",
        OUTPUT_FILE
    )


if __name__ == "__main__":
    main()
